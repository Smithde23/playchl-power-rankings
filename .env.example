DISCORD_TOKEN=PUT_SEPARATE_BOT_TOKEN_HERE
GUILD_ID=0
RANKINGS_CHANNEL_ID=0
ADMIN_ROLE_ID=0
# Railway Volume must be mounted at /data
DATABASE_PATH=/data/power_rankings.sqlite3
PLAYCHL_SCHEDULE_URL=https://playchl.com/schedule
# Optional: public JSON feed or your own trusted scores URL; overrides browser scraper
GAMES_JSON_URL=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# ET, Saturday after Friday-night game results have been entered
PUBLISH_DAY=Saturday
PUBLISH_HOUR=12
PUBLISH_MINUTE=0
POLL_MINUTES=30
# Import historic matches with /powerimport (JSON attachment) if site omits old results
# Forfeit games count in win/loss but not scoring stats (avoids artificial goal difference).
INCLUDE_FORFEITS_IN_RECORD=true
