# Must be a NEW Discord application; don't reuse any other bot's token
DISCORD_TOKEN=
GUILD_ID=1538583593603825704
RECAP_CHANNEL_ID=
DATABASE_PATH=/data/recaps.sqlite3
POLL_MINUTES=15
